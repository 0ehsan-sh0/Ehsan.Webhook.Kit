<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <TreatWarningsAsErrors Condition="'$(Configuration)' == 'Release'">true</TreatWarningsAsErrors>
    
    <!-- Package Metadata -->
    <Authors>Ehsan</Authors>
    <Company>Ehsan</Company>
    <Copyright>Copyright (c) $([System.DateTime]::Now.Year) Ehsan</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryType>git</RepositoryType>
    <RepositoryUrl>https://github.com/0ehsan-sh0/Ehsan.Webhook.Kit</RepositoryUrl>
    <PackageProjectUrl>https://github.com/0ehsan-sh0/Ehsan.Webhook.Kit</PackageProjectUrl>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <!-- Suppress missing XML comment warning during initial scaffolding -->
  <PropertyGroup Condition="'$(Configuration)' != 'Release'">
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>
</Project>
