<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <Description>Distributed deduplication and Redis storage provider for WebhookKit using StackExchange.Redis.</Description>
    <PackageTags>webhook;redis;deduplication;distributed-lock;stackexchange-redis</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\WebhookKit.Abstractions\WebhookKit.Abstractions.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="StackExchange.Redis" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.Options" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="WebhookKit.Redis.Tests" />
  </ItemGroup>

</Project>
