<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <Description>ASP.NET Core integration for WebhookKit, supporting Minimal APIs, MVC controllers, raw request buffering, and endpoint routing.</Description>
    <PackageTags>webhook;aspnetcore;minimal-api;mvc;security</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\WebhookKit.Core\WebhookKit.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="WebhookKit.AspNetCore.Tests" />
    <InternalsVisibleTo Include="WebhookKit.IntegrationTests" />
  </ItemGroup>

</Project>
